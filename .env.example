# --- Database ---
DATABASE_URL="postgresql://authenq:authenq@localhost:5432/authenq?schema=public"

# --- API ---
PORT=4000
NODE_ENV=development

# --- Auth ---
# Generate with: openssl rand -hex 32
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="12h"
BCRYPT_ROUNDS=10

# --- Storage ---
REPORT_STORAGE_DIR="./storage/reports"

# --- Integrations ---
# Shared secret used to verify simulated GitHub webhook signatures
GITHUB_WEBHOOK_SECRET="change-me"

# --- Frontend ---
VITE_API_BASE_URL="/api"
