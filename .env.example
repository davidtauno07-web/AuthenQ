# ---------------------------------------------------------------------------
# AuthenQ environment configuration. Copy to `.env` (repository root).
# Every variable is documented in docs/configuration.md.
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:5173
API_PORT=4000

# PostgreSQL (primary database, job queue, locks, rate-limit buckets)
DATABASE_URL=postgresql://authenq:authenq@localhost:5432/authenq?schema=public

# 32+ byte secrets. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me-dev-session-secret-0123456789abcdef
ENCRYPTION_KEY=change-me-dev-encryption-key-0123456789abcdef
CANARY_SECRET=change-me-dev-canary-secret-0123456789abcdef

# Session lifetime and rotation
SESSION_TTL_HOURS=168
SESSION_ROTATE_MINUTES=15

# Object storage: `local` (filesystem, default) or `s3` (S3 / MinIO / GCS interoperability)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=authenq
S3_ACCESS_KEY_ID=authenq
S3_SECRET_ACCESS_KEY=authenq-dev-secret
S3_FORCE_PATH_STYLE=true

# Background worker
WORKER_CONCURRENCY=2
WORKER_POLL_MS=750

# Email delivery: `log` writes verification/reset links to the API log (development only), `smtp` sends mail
EMAIL_DRIVER=log
SMTP_URL=
EMAIL_FROM=AuthenQ <no-reply@authenq.local>

# Optional external AI providers (only synthetic data and guidelines are ever sent)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=

# Seeded demo accounts (development / test only)
DEMO_PASSWORD=AuthenQ!Demo2026
